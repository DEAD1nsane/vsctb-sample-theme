    "semanticTokenColors": {
        "newOperator": "#ED0243",
        "stringLiteral": "#FFFFFF",
        "customLiteral": "#FFFFFF",
        "numberLiteral": "#FFFFFF"
    },
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#181818"
            }
        },
        {
            "scope": [
                "string",
                "constant"
            ],
            "settings": {
                "foreground": "#FFFFFF"
            }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#ED0243"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.class",
                "entity.name.type"
            ],
            "settings": {
                "foreground": "#FFFFFF",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other"
            ],
            "settings": {
                "foreground": "#FFFFFF"
            }
        }
    ]
}
